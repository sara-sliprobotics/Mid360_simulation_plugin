<?xml version='1.0'?>
<sdf version="1.4">
  <model name="standing_person">
    <static>true</static>
    <link name="person_link">
      <!-- Body visual -->
      <visual name="body">
        <pose>0 0 0.85 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.2</radius>
            <length>0.9</length>
          </cylinder>
        </geometry>
      </visual>
      <!-- Body collision -->
      <collision name="body_collision">
        <pose>0 0 0.85 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.2</radius>
            <length>0.9</length>
          </cylinder>
        </geometry>
      </collision>
      
      <!-- Head visual -->
      <visual name="head">
        <pose>0 0 1.55 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.15</radius>
          </sphere>
        </geometry>
      </visual>
      <!-- Head collision -->
      <collision name="head_collision">
        <pose>0 0 1.55 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.15</radius>
          </sphere>
        </geometry>
      </collision>
      
      <!-- Left Leg visual -->
      <visual name="left_leg">
        <pose>0 0.1 0.3 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.6</length>
          </cylinder>
        </geometry>
      </visual>
      <!-- Left Leg collision -->
      <collision name="left_leg_collision">
        <pose>0 0.1 0.3 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.6</length>
          </cylinder>
        </geometry>
      </collision>
      
      <!-- Right Leg visual -->
      <visual name="right_leg">
        <pose>0 -0.1 0.3 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.6</length>
          </cylinder>
        </geometry>
      </visual>
      <!-- Right Leg collision -->
      <collision name="right_leg_collision">
        <pose>0 -0.1 0.3 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>0.6</length>
          </cylinder>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
