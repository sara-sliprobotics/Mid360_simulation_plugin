<?xml version="1.0"?>
<sdf version="1.4">
  <world name="default">
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>
    
    <!-- Wall in front (positive X direction) -->
    <include>
      <uri>model://simple_wall</uri>
      <name>front_wall</name>
      <pose>10 0 1.25  0 0 0</pose>
    </include>
    
    <!-- Truck at back (negative X direction) -->
    <include>
      <uri>model://truck</uri>
      <name>truck_model</name>
      <pose>-10 0 0  0 0 1.5708</pose>
    </include>
    
    <!-- Tray -->
    <include>
      <uri>model://tray</uri>
      <name>tray_model</name>
      <pose>0 -4 0  0 0 0</pose>
    </include>
    
    <!-- Sliding person (controllable via /person_vel topic) -->
    <include>
      <uri>model://walking_person</uri>
      <pose>5 0 0 0 0 0</pose>
    </include>
    
  </world>
</sdf>

